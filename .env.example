# Optional, unsafe local development defaults. No .env is needed for docker compose up.
APP_ENV=development
DEBUG=false
POSTGRES_DB=pawly
POSTGRES_USER=pawly
POSTGRES_PASSWORD=unsafe-dev-password
JWT_SECRET=unsafe-dev-only-pawly-secret-change-before-production
COOKIE_SECURE=false
API_PORT=8000
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# pretrained_features (default) | trained_heads (needs CV_BUNDLE_DIR) | mock (tests only)
CV_MODE=pretrained_features
CV_BACKBONE=efficientnet_b0
CV_BUNDLE_DIR=
CV_DOG_SCORE_THRESHOLD=0.5
CV_FUSION=embedding-v1
SEARCH_TTL_SECONDS=86400
